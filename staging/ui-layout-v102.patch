+/** Shared landscape geometry for drawing, touch targets and the game viewport. */
+final class LandscapeLayout {
+    static class Profile {
+        float dpadX, dpadY, dpadScale = 1f;
+        float actionX, actionY, actionScale = 1f;
+        float shoulderX, shoulderY, shoulderScale = 1f;
+        float systemX, systemY, systemScale = 1f;
+        float menuX, menuY, menuScale = 1f;
+    }
+
+    static final class Box {
+        final float left, top, right, bottom;
+        Box(float left, float top, float right, float bottom) {
+            this.left = left; this.top = top; this.right = right; this.bottom = bottom;
+        }
+        float width() { return right - left; }
+        float height() { return bottom - top; }
+        float centerX() { return (left + right) * 0.5f; }
+        float centerY() { return (top + bottom) * 0.5f; }
+        boolean contains(float x, float y) {
+            return x >= left && x < right && y >= top && y < bottom;
+        }
+    }
+
+    final float viewportWidth, viewportHeight;
+    final int revision;
+    final Box video;
+    final float dpadX, dpadY, dpadSize, dpadHitRadius;
+    final float actionAX, actionAY, actionBX, actionBY, actionRadius, actionHitRadius;
+    final Box leftShoulder, rightShoulder, leftShoulderHit, rightShoulderHit;
+    final Box[] system = new Box[3];
+    final Box[] systemHit = new Box[3];
+
+    static float railWidth(float width, float height) {
+        return Math.min(width * 0.24f, height * 0.50f);
+    }
+
+    LandscapeLayout(float width, float height, float density, float toolbarBottom, Profile p, int revision) {
+        viewportWidth = width;
+        viewportHeight = height;
+        this.revision = revision;
+        float w = Math.max(1f, width), h = Math.max(1f, height);
+        float d = Math.max(0.1f, density);
+        float gap = Math.min(8f * d, h * 0.02f);
+        float rail = railWidth(w, h);
+        float top = Math.min(h - gap, Math.max(Math.min(48f * d, h * 0.22f), toolbarBottom + gap));
+        float remainingHeight = h - top;
+        float bottomBand = Math.min(remainingHeight * 0.40f, Math.max(52f * d, h * 0.12f));
+        float bottom = h - bottomBand;
+        video = new Box(rail + gap, top, w - rail - gap, bottom);
+
+        float sideWidth = Math.max(1f, rail - 2f * gap);
+        float shoulderBottom = top + (bottom - top) * 0.27f;
+        float shoulderHitH = Math.min(shoulderBottom - top - gap,
+                Math.max(44f * d, h * 0.10f * p.shoulderScale));
+        float shoulderH = Math.min(shoulderHitH, h * 0.07f * p.shoulderScale);
+        float shoulderHitW = Math.min(sideWidth,
+                Math.max(44f * d, w * 0.14f * p.shoulderScale));
+        float shoulderW = Math.min(shoulderHitW, w * 0.135f * p.shoulderScale);
+        float shoulderY = clamp((top + shoulderBottom) * 0.5f + h * p.shoulderY,
+                top + shoulderHitH / 2f, shoulderBottom - shoulderHitH / 2f);
+        float leftX = clamp(rail * 0.5f + w * p.shoulderX,
+                gap + shoulderHitW / 2f, rail - gap - shoulderHitW / 2f);
+        float rightX = clamp(w - rail * 0.5f + w * p.shoulderX,
+                w - rail + gap + shoulderHitW / 2f, w - gap - shoulderHitW / 2f);
+        leftShoulder = centered(leftX, shoulderY, shoulderW, shoulderH);
+        rightShoulder = centered(rightX, shoulderY, shoulderW, shoulderH);
+        leftShoulderHit = centered(leftX, shoulderY, shoulderHitW, shoulderHitH);
+        rightShoulderHit = centered(rightX, shoulderY, shoulderHitW, shoulderHitH);
+
+        float bodyTop = shoulderBottom + gap;
+        float bodyBottom = bottom - gap;
+        float bodyHeight = Math.max(1f, bodyBottom - bodyTop);
+        dpadSize = Math.min(h * 0.31f * 1.15f * p.dpadScale,
+                Math.min(sideWidth, bodyHeight) / 1.16f);
+        dpadHitRadius = dpadSize * 0.58f;
+        dpadX = clamp(rail * 0.5f + w * p.dpadX,
+                gap + dpadHitRadius, rail - gap - dpadHitRadius);
+        dpadY = clamp((bodyTop + bodyBottom) * 0.5f + h * p.dpadY,
+                bodyTop + dpadHitRadius, bodyBottom - dpadHitRadius);
+
+        // A/B touch circles stay separate and fit inside the right control column.
+        actionHitRadius = Math.min(h * 0.108f * p.actionScale,
+                Math.min(sideWidth / 3.25f, bodyHeight / 3.75f));
+        actionRadius = actionHitRadius * (0.088f / 0.108f);
+        float groupX = clamp(w - rail * 0.5f + w * p.actionX,
+                w - rail + gap + actionHitRadius * 1.625f,
+                w - gap - actionHitRadius * 1.625f);
+        float groupY = clamp((bodyTop + bodyBottom) * 0.5f + h * p.actionY,
+                bodyTop + actionHitRadius * 1.875f,
+                bodyBottom - actionHitRadius * 1.875f);
+        actionAX = groupX + actionHitRadius * 0.625f;
+        actionAY = groupY - actionHitRadius * 0.875f;
+        actionBX = groupX - actionHitRadius * 0.625f;
+        actionBY = groupY + actionHitRadius * 0.875f;
+
+        // Three equal cells keep MENU / SELECT / START aligned below the game.
+        float bandTop = bottom + gap, bandBottom = h - gap;
+        float cellWidth = video.width() / 3f;
+        for (int slot = 0; slot < 3; slot++) {
+            float scale = slot == 0 ? p.menuScale : p.systemScale;
+            float offsetX = slot == 0 ? p.menuX : p.systemX;
+            float offsetY = slot == 0 ? p.menuY : p.systemY;
+            float cellLeft = video.left + slot * cellWidth + gap;
+            float cellRight = video.left + (slot + 1) * cellWidth - gap;
+            float hitWidth = Math.min(cellRight - cellLeft,
+                    Math.max(44f * d, 110f * d * scale));
+            float hitHeight = Math.min(bandBottom - bandTop,
+                    Math.max(44f * d, 34f * d * scale));
+            float visibleHeight = Math.min(hitHeight, 34f * d * scale);
+            float x = clamp((cellLeft + cellRight) * 0.5f + w * offsetX,
+                    cellLeft + hitWidth / 2f, cellRight - hitWidth / 2f);
+            float y = clamp((bandTop + bandBottom) * 0.5f + h * offsetY,
+                    bandTop + hitHeight / 2f, bandBottom - hitHeight / 2f);
+            system[slot] = centered(x, y, hitWidth, visibleHeight);
+            systemHit[slot] = centered(x, y, hitWidth, hitHeight);
+        }
+    }
+
+    private static Box centered(float x, float y, float width, float height) {
+        return new Box(x - width / 2f, y - height / 2f, x + width / 2f, y + height / 2f);
+    }
+
+    private static float clamp(float value, float min, float max) {
+        return Math.max(min, Math.min(max, value));
+    }
