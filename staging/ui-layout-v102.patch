+package com.pocketframe.app;
+
+import java.util.Random;
+
+public final class LandscapeLayoutTest {
+    private static int cases;
+    private static void require(boolean ok, String message) {
+        if (!ok) throw new AssertionError(message);
+    }
+    private static boolean overlaps(LandscapeLayout.Box a, LandscapeLayout.Box b) {
+        return a.left < b.right - 0.01f && a.right > b.left + 0.01f
+                && a.top < b.bottom - 0.01f && a.bottom > b.top + 0.01f;
+    }
+    private static LandscapeLayout.Box circle(float x, float y, float radius) {
+        return new LandscapeLayout.Box(x - radius, y - radius, x + radius, y + radius);
+    }
+    private static void verify(float w, float h, float density, float toolbar, LandscapeLayout.Profile p) {
+        LandscapeLayout l = new LandscapeLayout(w, h, density, toolbar, p, 0);
+        require(l.video.width() > 0 && l.video.height() > 0, "collapsed video");
+        require(l.video.top >= toolbar, "toolbar blocks video");
+        LandscapeLayout.Box[] hits = {
+                circle(l.dpadX, l.dpadY, l.dpadHitRadius),
+                circle(l.actionAX, l.actionAY, l.actionHitRadius),
+                circle(l.actionBX, l.actionBY, l.actionHitRadius),
+                l.leftShoulderHit, l.rightShoulderHit,
+                l.systemHit[0], l.systemHit[1], l.systemHit[2]
+        };
+        for (LandscapeLayout.Box hit : hits) {
+            require(hit.width() > 0 && hit.height() > 0, "collapsed control");
+            require(hit.left >= -0.01f && hit.top >= -0.01f && hit.right <= w + 0.01f
+                    && hit.bottom <= h + 0.01f, "offscreen control");
+            require(!overlaps(hit, l.video), "control blocks video");
+        }
+        require(!overlaps(hits[0], hits[3]), "L blocks d-pad");
+        require(!overlaps(hits[1], hits[4]) && !overlaps(hits[2], hits[4]), "R blocks A/B");
+        float dx = l.actionAX - l.actionBX, dy = l.actionAY - l.actionBY;
+        require(dx * dx + dy * dy >= 4f * l.actionHitRadius * l.actionHitRadius,
+                "A/B touch circles overlap");
+        for (int i = 0; i < 3; i++) {
+            for (int j = i + 1; j < 3; j++) require(!overlaps(l.systemHit[i], l.systemHit[j]),
+                    "bottom touch targets overlap");
+        }
+        cases++;
+    }
+    public static void main(String[] args) {
+        float[][] devices = {{2340,1080,3}, {2400,1080,3}, {1920,1080,3},
+                {1280,800,2}, {1024,768,1.5f}, {2560,1600,2}, {840,360,1.25f},
+                {800,300,3}, {1000,360,3}};
+        Random random = new Random(102);
+        for (float[] device : devices) {
+            float w=device[0], h=device[1], d=device[2];
+            LandscapeLayout.Profile defaults = new LandscapeLayout.Profile();
+            verify(w,h,d,46*d,defaults);
+            LandscapeLayout l = new LandscapeLayout(w,h,d,46*d,defaults,0);
+            require(Math.abs(l.system[0].centerY()-l.system[1].centerY())<0.01f
+                    && Math.abs(l.system[1].centerY()-l.system[2].centerY())<0.01f,
+                    "default bottom row misaligned");
+            require(Math.abs(l.leftShoulder.centerY()-l.rightShoulder.centerY())<0.01f,
+                    "shoulders misaligned");
+            for (int i=0;i<1000;i++) {
+                LandscapeLayout.Profile p = new LandscapeLayout.Profile();
+                p.dpadX=random.nextFloat()*0.5f-0.25f; p.dpadY=random.nextFloat()*0.5f-0.25f;
+                p.actionX=random.nextFloat()*0.5f-0.25f; p.actionY=random.nextFloat()*0.5f-0.25f;
+                p.shoulderX=random.nextFloat()*0.5f-0.25f; p.shoulderY=random.nextFloat()*0.5f-0.25f;
+                p.systemX=random.nextFloat()*0.5f-0.25f; p.systemY=random.nextFloat()*0.5f-0.25f;
+                p.menuX=random.nextFloat()*0.5f-0.25f; p.menuY=random.nextFloat()*0.5f-0.25f;
+                p.dpadScale=0.6f+random.nextFloat(); p.actionScale=0.6f+random.nextFloat();
+                p.shoulderScale=0.6f+random.nextFloat(); p.systemScale=0.6f+random.nextFloat();
+                p.menuScale=0.6f+random.nextFloat();
+                verify(w,h,d,46*d,p);
+            }
+        }
+        System.out.println("PASS: " + cases + " landscape layouts; video clear, controls onscreen, touch targets distinct.");
+    }
+}
