diff -ruN rc4orig/app/src/main/java/com/pocketframe/app/DiagnosticLog.java rc5build/app/src/main/java/com/pocketframe/app/DiagnosticLog.java
--- rc4orig/app/src/main/java/com/pocketframe/app/DiagnosticLog.java	1970-01-01 00:00:00.000000000 +0000
+++ rc5build/app/src/main/java/com/pocketframe/app/DiagnosticLog.java	2026-10-07 01:03:00.262972412 +0000
@@ -0,0 +1,93 @@
+package com.pocketframe.app;
+
+import android.content.Context;
+import android.os.Build;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.nio.charset.StandardCharsets;
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.Locale;
+
+final class DiagnosticLog {
+    private static final long MAX_BYTES = 64 * 1024;
+    private static final long KEEP_BYTES = 48 * 1024;
+    private static final String FILE_NAME = "diagnostic.log";
+
+    private DiagnosticLog() {}
+
+    static synchronized void append(Context context, String event) {
+        try {
+            File file = new File(context.getFilesDir(), FILE_NAME);
+            trimIfNeeded(file);
+            String ts = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss.SSS", Locale.US).format(new Date());
+            String line = ts + "  " + sanitize(event) + "\n";
+            try (FileOutputStream out = new FileOutputStream(file, true)) {
+                out.write(line.getBytes(StandardCharsets.UTF_8));
+                out.getFD().sync();
+            }
+        } catch (Exception ignored) {}
+    }
+
+    static synchronized String report(Context context) {
+        StringBuilder out = new StringBuilder();
+        out.append("GBA PocketFrame diagnostic report\n");
+        out.append("App: 0.5.0-rc5\n");
+        out.append("Android: ").append(Build.VERSION.RELEASE).append(" (API ").append(Build.VERSION.SDK_INT).append(")\n");
+        out.append("Device: ").append(Build.MANUFACTURER).append(' ').append(Build.MODEL).append("\n");
+        out.append("ABI: ").append(Build.SUPPORTED_ABIS.length > 0 ? Build.SUPPORTED_ABIS[0] : "unknown").append("\n");
+        out.append("Network permission: none\n");
+        out.append("ROM names/content: not recorded; only a short SHA-256 identifier is logged.\n\n");
+        out.append("--- local event log ---\n");
+        try {
+            File file = new File(context.getFilesDir(), FILE_NAME);
+            if (!file.isFile()) return out.append("(empty)\n").toString();
+            try (FileInputStream in = new FileInputStream(file)) {
+                ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+                byte[] buf = new byte[8192];
+                int n;
+                while ((n = in.read(buf)) >= 0) if (n > 0) bytes.write(buf, 0, n);
+                out.append(bytes.toString(StandardCharsets.UTF_8.name()));
+            }
+        } catch (Exception e) {
+            out.append("(log read failed)\n");
+        }
+        return out.toString();
+    }
+
+    static synchronized void clear(Context context) {
+        try { new File(context.getFilesDir(), FILE_NAME).delete(); } catch (Exception ignored) {}
+    }
+
+    private static void trimIfNeeded(File file) throws Exception {
+        if (!file.isFile() || file.length() <= MAX_BYTES) return;
+        long len = file.length();
+        int keep = (int) Math.min(KEEP_BYTES, len);
+        byte[] tail = new byte[keep];
+        try (FileInputStream in = new FileInputStream(file)) {
+            long skip = Math.max(0, len - keep);
+            while (skip > 0) {
+                long s = in.skip(skip);
+                if (s <= 0) break;
+                skip -= s;
+            }
+            int off = 0;
+            while (off < tail.length) {
+                int n = in.read(tail, off, tail.length - off);
+                if (n < 0) break;
+                off += n;
+            }
+        }
+        try (FileOutputStream out = new FileOutputStream(file, false)) {
+            out.write(tail);
+        }
+    }
+
+    private static String sanitize(String text) {
+        if (text == null) return "";
+        return text.replace('\n', ' ').replace('\r', ' ');
+    }
+}
